# ---------------------------------------------------------------
# BitCompass environment variables
# Copy this file to `.env.local` and fill in your values.
# NEXT_PUBLIC_* values are baked in at build time — rebuild/redeploy after changing them.
# ---------------------------------------------------------------

# Public site URL (no trailing slash). Used for SEO: canonical URLs, sitemap, Open Graph, schema.
NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com

# Contact info shown in the footer, contact page and structured data (leave empty to hide)
NEXT_PUBLIC_CONTACT_EMAIL=hello@yourdomain.com
NEXT_PUBLIC_CONTACT_PHONE=+1 (555) 000-0000
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_CONTACT_HOURS=Mon – Fri, 9:00 – 18:00 (US Eastern Time)

# Social profiles (leave empty to hide)
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_GITHUB_URL=

# Search engine verification codes (Google Search Console / Bing Webmaster Tools)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ---------------------------------------------------------------
# Job application emails (server-only — never exposed to the browser)
# Works with any SMTP provider: Resend, Postmark, SendGrid, Amazon SES, Google Workspace, Microsoft 365...
# Test your settings with:  npm run smtp:test -- you@example.com
#
# Examples
#   Resend:         SMTP_HOST=smtp.resend.com     SMTP_PORT=465  SMTP_USER=resend  SMTP_PASS=<API key>
#   Microsoft 365:  SMTP_HOST=smtp.office365.com  SMTP_PORT=587  SMTP_USER=<full mailbox address>
#                   (requires "Authenticated SMTP" enabled for the mailbox; MAIL_FROM must be that mailbox)
# ---------------------------------------------------------------
SMTP_HOST=smtp.yourprovider.com
# 465 = TLS from the start, 587 = STARTTLS. The TLS mode is chosen from the port automatically.
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Sender shown on application emails. Use the same address as SMTP_USER unless your
# provider lets that mailbox send as another address (defaults to SMTP_USER).
MAIL_FROM="BitCompass Careers <careers@yourdomain.com>"

# Where applications are sent (comma-separated). Defaults to NEXT_PUBLIC_CONTACT_EMAIL.
APPLICATIONS_TO_EMAIL=

# Send a "we received your application" email to the candidate
SEND_APPLICANT_CONFIRMATION=true
