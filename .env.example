# ---------------------------------------------------------------
# BitCompass environment variables
# Copy this file to `.env.local` and fill in your values.
# NEXT_PUBLIC_* values are baked in at build time — rebuild/redeploy after changing them.
# ---------------------------------------------------------------

# Public site URL (no trailing slash). Used for SEO: canonical URLs, sitemap, Open Graph, schema.
NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com

# Contact info shown in the footer, contact page and structured data (leave empty to hide)
NEXT_PUBLIC_CONTACT_EMAIL=hello@yourdomain.com
NEXT_PUBLIC_CONTACT_PHONE=+1 (555) 000-0000
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_CONTACT_HOURS=Mon – Fri, 9:00 – 18:00 (US Eastern Time)

# Social profiles (leave empty to hide)
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_GITHUB_URL=

# Search engine verification codes (Google Search Console / Bing Webmaster Tools)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ---------------------------------------------------------------
# Job application emails (server-only — never exposed to the browser)
# Works with any SMTP provider: Google Workspace, Microsoft 365, Zoho, SendGrid, Mailgun, Resend, Amazon SES...
# ---------------------------------------------------------------
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
# "true" for port 465 (SSL), "false" for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Sender shown on application emails (must be allowed by your SMTP provider)
MAIL_FROM="BitCompass Careers <careers@yourdomain.com>"

# Where applications are sent (comma-separated). Defaults to NEXT_PUBLIC_CONTACT_EMAIL.
APPLICATIONS_TO_EMAIL=

# Send a "we received your application" email to the candidate
SEND_APPLICANT_CONFIRMATION=true
